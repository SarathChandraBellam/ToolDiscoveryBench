# --- OpenRouter: Jev + GPT-6 Luna Decisions with one key (routers or-*) ---
OPENROUTER_API_KEY=
# OPENROUTER_REFERER=https://github.com/SarathChandraBellam/ToolDiscoveryBench

# --- Jev (TypeSafe, direct) ---
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# gateway route (Bifrost / NanoGPT) — enable `jev-gateway` in bench.yaml
# TDB_JEV_GATEWAY=true
# JEV_GATEWAY_URL=https://nano-gpt.com/api
# JEV_GATEWAY_KEY=

# --- OpenAI Decisions API (also used by Strands provider=openai) ---
# OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# --- Hugging Face Inference Providers (Strands provider=huggingface) ---
HF_TOKEN=                            # also unlocks more Hugging Face MCP tools
# HF_STRANDS_MODEL=Qwen/Qwen3-32B

# --- Strands (default provider: bedrock) ---
AWS_REGION=us-east-1
# AWS_PROFILE=default
# STRANDS_PROVIDER=anthropic         # or openai / huggingface / litellm
# STRANDS_MODEL_ID=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- optional baselines ---
# TDB_EMBED=true                     # needs `pip install fastembed`

# --- auth MCP servers (off by default) ---
# GITHUB_MCP_ENABLED=true
# GITHUB_PAT=
# M365_MCP_ENABLED=true
# M365_MCP_URL=http://localhost:8000/mcp
# M365_ACCESS_TOKEN=
# CONTEXT7_API_KEY=

